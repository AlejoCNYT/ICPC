class Solution:
    def computeArea(self, ax1: int, ay1: int, ax2: int, ay2: int, bx1: int, by1: int, bx2: int, by2: int) -> int:
        
        # Calculate the individual area of each rectangle
        area_a = (ax2 - ax1) * (ay2 - ay1)
        area_b = (bx2 - bx1) * (by2 - by1)
        
        # Main control flow: check for overlap
        if self.is_not_overlapping(ax1, ay1, ax2, ay2, bx1, by1, bx2, by2):
            return self.no_overlapped(area_a, area_b)
        else:
            area_overlap = self.calculate_overlap(ax1, ay1, ax2, ay2, bx1, by1, bx2, by2)
            return self.overlapped(area_a, area_b, area_overlap)

    def calculate_overlap(self, ax1: int, ay1: int, ax2: int, ay2: int, bx1: int, by1: int, bx2: int, by2: int) -> int:
        """Calculates the overlapping area (intersection) between the two rectangles.""" 
        # Height of the intersection
        height = min(by2, ay2) - max(by1, ay1)
        # Base/width of the intersection
        base = min(ax2, bx2) - max(ax1, bx1)
        
        return base * height

    def is_not_overlapping(self, ax1: int, ay1: int, ax2: int, ay2: int, bx1: int, by1: int, bx2: int, by2: int) -> bool:
        """Checks if the rectangles do NOT touch or overlap at all."""
        # Returns True if one rectangle is completely to the left, right, top, or bottom of the other
        return (bx1 > ax2) or (ax1 > bx2) or (by1 > ay2) or (ay1 > by2)

    def no_overlapped(self, area_a: int, area_b: int) -> int:
        """Calculates the total area when there is no overlap (simple sum)."""
        return area_a + area_b

    def overlapped(self, area_a: int, area_b: int, area_overlap: int) -> int:
        """Calculates the total area when they DO overlap by subtracting the intersection."""
        return area_a + area_b - area_overlap
